@model AdminTable
@{ ViewData["Title"] = Model.Title; var section = Model.Section; string[] states = section switch { "bookings" => Enum.GetNames<BookingStatus>(), "payments" => Enum.GetNames<PaymentStatus>(), "tickets" => Enum.GetNames<TicketStatus>(), _ => ["active", "inactive"] }; }
<div class="admin-heading"><div><span class="eyebrow">QUẢN LÝ HỆ THỐNG</span><h1>@Model.Title</h1><p>@Model.Total bản ghi · Thông tin được lưu trong MySQL</p></div>@if (Model.Editable) { <a class="btn btn-vega" href="/Admin/Catalog/Edit?section=@(section)">+ Thêm mới</a> }</div>
<form class="filter-bar" method="get"><input type="hidden" name="section" value="@(section)" /><div><label for="search">Tìm kiếm</label><input id="search" name="search" value="@ViewBag.Search" placeholder="Nhập từ khóa…" /></div>@if (section != "logs") { <div><label for="filter">Trạng thái</label><select id="filter" name="filter"><option value="">Tất cả</option>@foreach (var state in states) { <option selected="@((string?)ViewBag.Filter == state)" value="@state">@(state == "active" ? "Đang hoạt động" : state == "inactive" ? "Ngừng hoạt động" : state)</option> }</select></div> }<button type="submit" class="btn btn-dark">Tìm kiếm →</button></form>
<div class="admin-table-wrap table-responsive"><table class="table admin-table"><thead><tr>@foreach (var column in Model.Columns) { <th>@column</th> }<th></th></tr></thead><tbody>@foreach (var row in Model.Rows) { <tr>@foreach (var cell in row.Cells) { <td>@T(cell)</td> }<td>@if (Model.Editable) { <a href="/Admin/Catalog/Edit?section=@(section)&id=@row.Id">Xem / Sửa ↗</a> } else if (!string.IsNullOrEmpty(row.Id)) { <a href="/Booking/Details/@row.Id">Chi tiết đơn ↗</a> }</td></tr> }</tbody></table>@if (Model.Rows.Count == 0) { <div class="empty-state">Chưa có dữ liệu phù hợp.</div> }</div>
<nav class="pagination-bar" aria-label="Phân trang">@for (var page = Math.Max(1, Model.Page - 3); page <= Math.Min((int)Math.Ceiling(Model.Total / 15d), Model.Page + 3); page++) { <a class="@(page == Model.Page ? "selected" : "")" asp-route-section="@(section)" asp-route-search="@ViewBag.Search" asp-route-filter="@ViewBag.Filter" asp-route-page="@(page)">@(page)</a> }</nav>
