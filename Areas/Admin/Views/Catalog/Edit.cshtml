@model AdminEditor
@{ ViewData["Title"] = Model.Title; }
<a class="back-link" href="/Admin/Catalog?section=@Model.Section">← Trở về @Model.Title.ToLower()</a><div class="admin-heading"><div><span class="eyebrow">CẬP NHẬT DỮ LIỆU</span><h1>@(string.IsNullOrEmpty(Model.Id) ? "Thêm mới" : "Chi tiết & chỉnh sửa") · @Model.Title</h1></div></div>
<form class="panel form-panel admin-editor" method="post"><input type="hidden" name="section" value="@Model.Section" /><input type="hidden" name="id" value="@Model.Id" /><div asp-validation-summary="All" class="form-error"></div>
@foreach (var field in Model.Fields) { <div class="editor-field"><label for="field-@field.Name">@field.Label @if (field.Required) { <span class="red">*</span> }</label>@if (field.Type == "select") { <select id="field-@field.Name" name="values[@field.Name]">@foreach (var option in field.Options!) { <option selected="@(field.Value == option.Value)" value="@option.Value">@T(option.Text)</option> }</select> } else if (field.Type == "textarea") { <textarea id="field-@field.Name" name="values[@field.Name]" rows="5" required="@field.Required" maxlength="4000">@field.Value</textarea> } else { <input id="field-@field.Name" name="values[@field.Name]" type="@field.Type" value="@(field.Type == "password" ? "" : field.Value)" required="@field.Required" min="@(field.Type == "number" ? "1" : null)" autocomplete="@(field.Type == "password" ? "new-password" : "off")" /> }</div> }
<p class="muted small">Thông tin đã tham gia giao dịch được bảo toàn. Dùng trạng thái ngừng hoạt động để ẩn khỏi quy trình đặt vé mới.</p><div class="order-actions"><button type="submit" class="btn btn-vega">Lưu thay đổi →</button><a class="btn btn-outline-secondary" href="/Admin/Catalog?section=@Model.Section">Quay lại</a></div></form>
