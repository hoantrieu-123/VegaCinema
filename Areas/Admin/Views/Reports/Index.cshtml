@model ReportResult
@{ ViewData["Title"] = "Báo cáo thống kê"; }
<div class="admin-heading"><div><span class="eyebrow">THẤU HIỂU HOẠT ĐỘNG RẠP</span><h1>Báo cáo thống kê</h1><p>@(User.IsInRole(Roles.Admin) ? "Phạm vi toàn hệ thống" : "Phạm vi cụm rạp được cấp quyền") · Giá trị hoàn tiền mô phỏng được loại khỏi doanh thu.</p></div></div><form class="filter-bar" method="get"><div><label for="from">Từ ngày</label><input id="from" type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" /></div><div><label for="to">Đến ngày</label><input id="to" type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" /></div><button class="btn btn-dark" type="submit">Xem báo cáo →</button></form><partial name="_Report" model="Model" />
