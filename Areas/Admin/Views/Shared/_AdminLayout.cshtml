<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] · VEGA Quản trị</title><link rel="icon" href="/images/vega.svg" type="image/svg+xml" /><link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="/css/site.css" asp-append-version="true" /></head><body class="admin-body"><aside class="admin-sidebar"><a class="brand" href="/"><span class="brand-mark">V<span>✦</span></span><span>VEGA<small>C I N E M A S</small></span></a><span class="eyebrow">ĐIỀU HÀNH HỆ THỐNG</span><nav aria-label="Quản trị">
@if (User.IsInRole(Roles.Admin)) { <a href="/Admin">◈ Tổng quan</a>@foreach (var section in AdminService.Sections) { <a class="@(Context.Request.Query["section"] == section.Key ? "selected" : "")" href="/Admin/Catalog?section=@(section.Key)">@(section.Value)</a> }<a href="/Staff">Tra cứu giao dịch ↗</a><a href="/Staff/Check">Kiểm soát vé ↗</a> }
<a href="/Admin/Reports">Báo cáo thống kê</a><a href="/">← Về website</a></nav><div class="sidebar-bottom">VEGA WORKSPACE<br /><small>Hệ thống quản lý rạp chiếu</small><form action="/Account/Logout" method="post">@Html.AntiForgeryToken()<button type="submit">Đăng xuất ↗</button></form></div></aside><main class="admin-main"><header class="admin-top"><span>WORKSPACE / VEGA CINEMAS</span><a href="/Account/Profile">@User.Identity?.Name</a></header><div class="admin-content">
@if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }@if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }@RenderBody()</div></main><script src="/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
