@model ReportResult
<div class="stats-grid"><div class="stat-card"><span>DOANH THU THUẦN</span><strong>@VietnamTime.Money(Model.Revenue)</strong><small>Đơn đã phát hành vé, chưa hủy</small></div><div class="stat-card"><span>VÉ ĐÃ BÁN</span><strong>@Model.Tickets.ToString("N0")</strong><small>Số vé thuộc đơn hợp lệ</small></div><div class="stat-card"><span>GIAO DỊCH THÀNH CÔNG</span><strong>@Model.Transactions.ToString("N0")</strong><small>Theo thời điểm tạo booking</small></div></div>
<div class="report-grid"><section class="panel report-panel"><h2>Doanh thu theo phim</h2>@foreach (var item in Model.Movies.OrderByDescending(x => x.Revenue)) { <div class="report-bar-row"><div><span>@item.Name</span><strong>@VietnamTime.Money(item.Revenue)</strong></div><div class="report-bar"><i style="width: @((Model.Revenue == 0 ? 0 : item.Revenue / Model.Revenue * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></i></div><small>@item.Tickets vé</small></div> }@if (Model.Movies.Count == 0) { <p class="muted">Chưa có giao dịch trong khoảng thời gian này.</p> }</section><section class="panel report-panel"><h2>Doanh thu theo rạp</h2><table class="table admin-table"><thead><tr><th>Rạp chiếu</th><th>Vé</th><th>Doanh thu</th></tr></thead><tbody>@foreach (var item in Model.Cinemas) { <tr><td>@item.Name</td><td>@item.Tickets</td><td>@VietnamTime.Money(item.Revenue)</td></tr> }</tbody></table></section></div>
<section class="panel report-panel mt-4"><h2>Hoạt động suất chiếu</h2><div class="table-responsive"><table class="table admin-table"><thead><tr><th>Suất chiếu</th><th>Vé đã bán</th><th>Doanh thu</th></tr></thead><tbody>@foreach (var item in Model.Showtimes) { <tr><td>@item.Name</td><td>@item.Tickets</td><td>@VietnamTime.Money(item.Revenue)</td></tr> }</tbody></table></div></section>
