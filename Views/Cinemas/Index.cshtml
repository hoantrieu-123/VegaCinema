@model List<CinemaCluster>
@{ ViewData["Title"] = "Hệ thống rạp"; }
<section class="container page-section"><div class="page-heading"><span class="eyebrow">ĐIỂM HẸN CỦA NHỮNG NGƯỜI YÊU PHIM</span><h1>Gần bạn. Gần điện ảnh<span class="red">.</span></h1><p>Không gian hiện đại, chỗ ngồi thoải mái và những câu chuyện không giới hạn.</p></div>
@foreach (var cluster in Model) { <div class="cinema-cluster"><div class="section-heading"><h2>@cluster.Name</h2><span class="muted">◎ @cluster.City</span></div><div class="cinema-grid">@foreach (var cinema in cluster.Cinemas) { <article class="cinema-card"><div class="cinema-illustration"><span>VEGA</span><b>C I N E M A S</b><i>✦</i></div><div class="cinema-card-copy"><span class="eyebrow">@cluster.City</span><h3>@cinema.Name</h3><p>@cinema.Address</p><div class="cinema-tags"><span>@cinema.Rooms.Count phòng chiếu</span><span>Dolby 7.1</span><span>Ghế VIP</span></div><a class="btn btn-vega" href="/Schedule?cinemaId=@cinema.Id">Lịch chiếu tại rạp ↗</a></div></article> }</div></div> }</section>
