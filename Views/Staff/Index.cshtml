@model List<Booking>
@{ ViewData["Title"] = "Tra cứu đơn"; }
<section class="container page-section"><div class="page-heading"><span class="eyebrow">VEGA · NHÂN VIÊN</span><h1>Tra cứu đơn đặt vé<span class="red">.</span></h1><p>Dữ liệu được giới hạn theo cụm rạp được cấp quyền.</p></div><form class="filter-bar" method="get"><div><label for="search">Mã đơn hoặc email</label><input id="search" name="search" value="@ViewBag.Search" /></div><button class="btn btn-vega" type="submit">Tra cứu →</button></form><div class="table-responsive"><table class="table vega-table"><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Phim</th><th>Trạng thái</th><th>Số tiền</th><th></th></tr></thead><tbody>@foreach (var b in Model) { <tr><td class="break-word">@b.Code</td><td>@b.User.Email</td><td>@b.Showtime.Movie.Title</td><td>@T(b.Status)</td><td>@VietnamTime.Money(b.Total)</td><td><a href="/Booking/Details/@b.Id">Chi tiết ↗</a></td></tr> }</tbody></table></div><nav class="pagination-bar">@for (var p = 1; p <= (int)Math.Ceiling((int)ViewBag.Total / 15d); p++) { <a asp-route-search="@ViewBag.Search" asp-route-page="@p">@p</a> }</nav></section>
