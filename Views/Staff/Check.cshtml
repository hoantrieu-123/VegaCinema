@model Ticket
@{ ViewData["Title"] = "Kiểm soát vé"; }
<section class="container page-section narrow-page"><div class="page-heading"><span class="eyebrow">VEGA · KIỂM SOÁT VÉ</span><h1>Chào mừng vào rạp<span class="red">.</span></h1><p>Dùng máy quét QR để nhập mã vào ô bên dưới, hoặc nhập mã vé thủ công.</p></div><form class="panel form-panel" method="get"><label for="code">Mã vé</label><input id="code" name="code" value="@ViewBag.Code" placeholder="VEGA-…" autofocus autocomplete="off" maxlength="64" /><button class="btn btn-vega mt-3" type="submit">Kiểm tra vé →</button></form>
@if (ViewBag.Message is string message) { <div class="alert alert-warning mt-4">@message</div> }
@if (Model is not null) { <div class="panel form-panel mt-4"><span class="status-pill">@T(Model.Status)</span><h2 class="mt-3">@Model.BookingDetail.Booking.Showtime.Movie.Title</h2><p>@Model.BookingDetail.Booking.Showtime.ScreeningRoom.Cinema.Name · @Model.BookingDetail.Booking.Showtime.ScreeningRoom.Name</p><p>Ghế <strong>@Model.BookingDetail.ShowtimeSeat.Seat.Label</strong> · @VietnamTime.Local(Model.BookingDetail.Booking.Showtime.StartsAtUtc).ToString("HH:mm dd/MM/yyyy")</p>@if (Model.Status == TicketStatus.VALID) { <form action="/Staff/Use" method="post">@Html.AntiForgeryToken()<input type="hidden" name="code" value="@Model.Code" /><button class="btn btn-vega" type="submit">Xác nhận sử dụng vé ✓</button></form> } else { <p class="form-error">Vé đã sử dụng hoặc bị hủy. Không thể xác nhận lại.</p> }</div> }</section>
