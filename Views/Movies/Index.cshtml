@model MoviePage
@{ ViewData["Title"] = "Thế giới điện ảnh"; }
<section class="container page-section"><div class="page-heading"><span class="eyebrow">TÌM CÂU CHUYỆN CỦA BẠN</span><h1>Thế giới điện ảnh<span class="red">.</span></h1><p>Những bộ phim đáng xem. Những trải nghiệm đáng nhớ.</p></div>
<form class="filter-bar" method="get"><div><label for="search">Tên phim</label><input id="search" name="search" value="@Model.Search" placeholder="Bạn đang tìm phim gì?" maxlength="160" /></div><div><label for="genre">Thể loại</label><select id="genre" name="genre"><option value="">Tất cả thể loại</option>@foreach (var genre in new[] { "Phim điện ảnh", "Hành động", "Khoa học viễn tưởng", "Tình cảm", "Hoạt hình", "Tâm lý", "Phiêu lưu", "Kỳ ảo" }) { <option selected="@(Model.Genre == genre)" value="@genre">@genre</option> }</select></div><div><label for="status">Trạng thái</label><select id="status" name="status"><option value="">Tất cả phim</option><option value="NOW_SHOWING" selected="@(Model.Status == MovieStatus.NOW_SHOWING)">Đang chiếu</option><option value="COMING_SOON" selected="@(Model.Status == MovieStatus.COMING_SOON)">Sắp chiếu</option></select></div><button type="submit" class="btn btn-vega">Tìm phim ↗</button></form>
<p class="result-count">@Model.Total bộ phim dành cho bạn</p><div class="movie-grid">@foreach (var movie in Model.Movies) { <partial name="_MovieCard" model="movie" /> }</div>
@if (Model.Total == 0) { <div class="empty-state"><span>⌕</span><h2>Chưa tìm thấy bộ phim phù hợp</h2><p>Hãy thử một từ khóa hoặc thể loại khác.</p><a class="btn btn-outline-light" href="/Movies">Xem tất cả phim</a></div> }
<nav class="pagination-bar" aria-label="Phân trang">@for (var page = 1; page <= (int)Math.Ceiling(Model.Total / 12d); page++) { <a class="@(page == Model.Page ? "selected" : "")" asp-action="Index" asp-route-search="@Model.Search" asp-route-genre="@Model.Genre" asp-route-status="@T(Model.Status)" asp-route-page="@(page)">@(page)</a> }</nav>
</section>
