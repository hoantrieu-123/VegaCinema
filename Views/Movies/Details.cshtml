@model MovieDetails
@{ ViewData["Title"] = Model.Movie.Title; }
<section class="container page-section"><a class="back-link" href="/Movies">← Trở về danh sách phim</a><div class="movie-detail"><img class="detail-poster" src="@Model.Movie.PosterUrl" alt="Poster @Model.Movie.Title" /><div class="detail-copy"><span class="eyebrow">@(Model.Movie.Status == MovieStatus.NOW_SHOWING ? "ĐANG CHIẾU TẠI VEGA" : "SẮP CHẠM MÀN ẢNH")</span><h1>@Model.Movie.Title</h1><div class="detail-meta"><span class="age-badge static">@Model.Movie.AgeRating</span><span>@Model.Movie.Genre</span><span>@Model.Movie.DurationMinutes phút</span><span>2D · Phụ đề Việt</span></div><dl class="detail-info"><div><dt>Khởi chiếu</dt><dd>@Model.Movie.ReleaseDate.ToString("dd/MM/yyyy")</dd></div><div><dt>Trạng thái</dt><dd>@(Model.Movie.Status == MovieStatus.NOW_SHOWING ? "Đang chiếu" : "Sắp chiếu")</dd></div></dl><h2>Nội dung phim</h2><p class="synopsis">@Model.Movie.Description</p><p class="muted small">Phim giả lập phục vụ đồ án. Vui lòng tuân thủ phân loại độ tuổi khi đặt vé.</p>@if (Model.Movie.Status == MovieStatus.NOW_SHOWING) { <a class="btn btn-vega" href="#showtimes">Chọn suất chiếu ↓</a> }</div></div>
<div id="showtimes" class="section"><div class="section-heading"><div><span class="eyebrow">CUỘC HẸN CỦA BẠN</span><h2>Lịch chiếu</h2></div></div><form class="filter-bar" method="get"><div><label for="date">Ngày xem</label><input id="date" type="date" name="date" value="@Model.Date?.ToString("yyyy-MM-dd")" /></div><div><label for="cinemaId">Rạp chiếu</label><select id="cinemaId" name="cinemaId"><option value="">Tất cả rạp</option>@foreach (var c in Model.Clusters.SelectMany(x => x.Cinemas)) { <option value="@c.Id" selected="@(Model.CinemaId == c.Id)">@c.Name</option> }</select></div><button class="btn btn-vega" type="submit">Xem lịch chiếu</button></form>
@foreach (var day in Model.Showtimes.GroupBy(x => VietnamTime.Local(x.StartsAtUtc).Date)) { <div class="schedule-day"><h3>@day.Key.ToString("dd/MM/yyyy")</h3>@foreach (var cinema in day.GroupBy(x => x.ScreeningRoom.Cinema.Name)) { <div class="schedule-row"><div><h4>@cinema.Key</h4><span class="muted">2D · Phụ đề Việt</span></div><div class="time-options">@foreach (var show in cinema) { <a href="/Booking/Seats/@show.Id">@VietnamTime.Local(show.StartsAtUtc).ToString("HH:mm")<small>từ @VietnamTime.Money(show.StandardPrice)</small></a> }</div></div> }</div> }
@if (Model.Showtimes.Count == 0) { <div class="empty-state">Chưa có suất chiếu phù hợp. Hãy chọn ngày hoặc rạp khác.</div> }</div></section>
