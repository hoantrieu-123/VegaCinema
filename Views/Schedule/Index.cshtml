@model SchedulePage
@{ ViewData["Title"] = "Lịch chiếu"; }
<section class="container page-section"><div class="page-heading"><span class="eyebrow">SẮP XẾP MỘT CUỘC HẸN ĐIỆN ẢNH</span><h1>Lịch chiếu<span class="red">.</span></h1><p>Chọn thời gian của bạn. Phần còn lại, để VEGA.</p></div>
<form class="filter-bar" method="get"><div><label for="movieId">Phim</label><select name="movieId" id="movieId"><option value="">Tất cả phim</option>@foreach (var movie in Model.Movies) { <option value="@movie.Id" selected="@(movie.Id == Model.MovieId)">@movie.Title</option> }</select></div><div><label for="cinemaId">Rạp</label><select name="cinemaId" id="cinemaId"><option value="">Tất cả rạp</option>@foreach (var cinema in Model.Clusters.SelectMany(x => x.Cinemas)) { <option value="@cinema.Id" selected="@(cinema.Id == Model.CinemaId)">@cinema.Name</option> }</select></div><div><label for="date">Ngày xem</label><input id="date" name="date" type="date" value="@Model.Date.ToString("yyyy-MM-dd")" /></div><button class="btn btn-vega" type="submit">Tìm suất chiếu ↗</button></form>
<div class="date-strip">@for (var day = 0; day < 7; day++) { var d = VietnamTime.Local(DateTime.UtcNow).Date.AddDays(day); <a class="@(d == Model.Date ? "selected" : "")" asp-route-date="@d.ToString("yyyy-MM-dd")" asp-route-movieId="@Model.MovieId" asp-route-cinemaId="@Model.CinemaId"><span>@(day == 0 ? "Hôm nay" : d.ToString("ddd", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")))</span><b>@d.ToString("dd/MM")</b></a> }</div>
@foreach (var group in Model.Showtimes.GroupBy(x => x.MovieId)) { var first = group.First(); <article class="schedule-movie"><a href="/Movies/Details/@first.MovieId"><img src="@first.Movie.PosterUrl" alt="@first.Movie.Title" /></a><div><span class="eyebrow">@first.Movie.Genre · @first.Movie.DurationMinutes PHÚT</span><h2><a href="/Movies/Details/@first.MovieId">@first.Movie.Title</a></h2>@foreach (var cinema in group.GroupBy(x => x.ScreeningRoom.Cinema.Name)) { <h3>@cinema.Key <small>2D · Phụ đề Việt</small></h3><div class="time-options">@foreach (var show in cinema) { <a href="/Booking/Seats/@show.Id">@VietnamTime.Local(show.StartsAtUtc).ToString("HH:mm")<small>@VietnamTime.Money(show.StandardPrice)</small></a> }</div> }</div></article> }
@if (Model.Showtimes.Count == 0) { <div class="empty-state"><h2>Chưa có suất chiếu phù hợp</h2><p>Hãy chọn ngày tiếp theo hoặc một rạp khác.</p></div> }</section>
