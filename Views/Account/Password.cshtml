@model PasswordInput
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<section class="container page-section narrow-page"><div class="page-heading"><span class="eyebrow">BẢO VỆ TÀI KHOẢN</span><h1>Đổi mật khẩu<span class="red">.</span></h1></div><form class="panel form-panel" method="post"><div asp-validation-summary="All" class="form-error"></div><label asp-for="CurrentPassword">Mật khẩu hiện tại</label><input asp-for="CurrentPassword" type="password" autocomplete="current-password" /><label asp-for="NewPassword">Mật khẩu mới</label><input asp-for="NewPassword" type="password" autocomplete="new-password" /><label asp-for="ConfirmPassword">Nhập lại mật khẩu mới</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" /><button class="btn btn-vega mt-4" type="submit">Đổi mật khẩu →</button></form></section>
