@model LoginInput
@{ ViewData["Title"] = "Đăng nhập"; }
<section class="auth-section container"><div class="auth-art"><span class="eyebrow">YOUR NEXT STORY STARTS HERE</span><h1>Một tài khoản.<br />Ngàn <em>cảm xúc.</em></h1><p>Đặt vé dễ dàng. Lưu giữ mọi cuộc hẹn điện ảnh.</p><div class="auth-star" aria-hidden="true">✦</div></div><div class="auth-panel panel"><span class="eyebrow">CHÀO MỪNG BẠN TRỞ LẠI</span><h2>Đăng nhập</h2><p class="muted">Rạp phim yêu thích chỉ cách bạn một bước.</p><form method="post"><div asp-validation-summary="ModelOnly" class="form-error"></div><input asp-for="ReturnUrl" type="hidden" /><label asp-for="Email">Email</label><input asp-for="Email" type="email" autocomplete="username" placeholder="ban@example.com" /><span asp-validation-for="Email" class="form-error"></span><label asp-for="Password">Mật khẩu</label><input asp-for="Password" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu của bạn" /><span asp-validation-for="Password" class="form-error"></span><label class="checkbox-label"><input asp-for="RememberMe" /> Ghi nhớ đăng nhập</label><button class="btn btn-vega w-100" type="submit">Đăng nhập →</button></form><p class="auth-switch">Chưa có tài khoản? <a href="/Account/Register">Đăng ký ngay ↗</a></p></div></section>
