@model RegisterInput
@{ ViewData["Title"] = "Đăng ký"; }
<section class="auth-section registration-section container">
    <div class="auth-art">
        <span class="eyebrow">BECOME PART OF THE STORY</span>
        <h1>Gia nhập VEGA.<br />Bắt đầu <em>trải nghiệm.</em></h1>
        <p>Một thế giới điện ảnh đang chờ được khám phá. Lưu thông tin một lần để đặt vé thuận tiện hơn.</p>
        <div class="auth-star" aria-hidden="true">✦</div>
    </div>
    <div class="auth-panel registration-panel panel">
        <span class="eyebrow">CUỘC HẸN ĐẦU TIÊN</span>
        <h2>Tạo tài khoản</h2>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div>
            <partial name="_CustomerProfileFields" model="Model" />
            <label asp-for="Email">Email</label>
            <input asp-for="Email" type="email" autocomplete="email" maxlength="256" required />
            <span asp-validation-for="Email" class="form-error"></span>
            <label asp-for="Password">Mật khẩu</label>
            <input asp-for="Password" type="password" autocomplete="new-password" minlength="8" required />
            <small class="muted">Tối thiểu 8 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt.</small>
            <span asp-validation-for="Password" class="form-error"></span>
            <label asp-for="ConfirmPassword">Nhập lại mật khẩu</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
            <span asp-validation-for="ConfirmPassword" class="form-error"></span>
            <button class="btn btn-vega w-100 mt-4" type="submit">Tạo tài khoản →</button>
        </form>
        <p class="auth-switch">Đã có tài khoản? <a href="/Account/Login">Đăng nhập</a></p>
    </div>
</section>
