@model CheckoutPage
@{ ViewData["Title"] = "Thanh toán"; var b = Model.Booking; var show = b.Showtime; var pending = b.Status is BookingStatus.SEAT_HELD or BookingStatus.PAYMENT_PENDING && b.ExpiresAtUtc > Model.ServerNowUtc; }
<section class="container page-section"><div class="booking-steps"><span class="done">01 · Chọn phim & suất</span><span class="done">02 · Chọn ghế</span><span class="current">03 · Thanh toán</span><span>04 · Nhận vé</span></div><div class="page-heading"><span class="eyebrow">CHỈ CÒN MỘT BƯỚC NỮA</span><h1>Hoàn tất cuộc hẹn<span class="red">.</span></h1></div>
<div class="booking-grid"><div><div class="panel checkout-detail"><div class="summary-movie"><img src="@show.Movie.PosterUrl" alt="@show.Movie.Title" /><div><span class="eyebrow">THÔNG TIN ĐẶT VÉ</span><h2>@show.Movie.Title</h2><p>@show.ScreeningRoom.Cinema.Name · @show.ScreeningRoom.Name</p><p>@VietnamTime.Local(show.StartsAtUtc).ToString("dd/MM/yyyy · HH:mm")</p><p>Ghế: <strong>@string.Join(", ", b.Details.Select(x => x.ShowtimeSeat.Seat.Label))</strong></p></div></div></div>
<div class="panel checkout-method"><h2>Phương thức thanh toán</h2><p class="muted">Cổng thanh toán mô phỏng cho đồ án. Không thu tiền thật.</p>
@if (pending) { <form id="payment-form" action="/Booking/Pay" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@b.Id" /><label class="payment-choice"><input type="radio" name="scenario" value="SUCCESS" checked /><span class="payment-icon">✓</span><span><strong>Thanh toán thành công</strong><small>Xác nhận giao dịch và nhận vé điện tử</small></span></label><label class="payment-choice"><input type="radio" name="scenario" value="FAILED" /><span class="payment-icon">×</span><span><strong>Mô phỏng thất bại</strong><small>Giao dịch bị từ chối, giải phóng ghế</small></span></label><label class="payment-choice"><input type="radio" name="scenario" value="TIMEOUT" /><span class="payment-icon">◷</span><span><strong>Mô phỏng hết thời gian</strong><small>Giao dịch hết hạn, không phát hành vé</small></span></label></form> }
else { <div class="alert alert-warning">Đơn @b.Status. Không thể tiếp tục thanh toán.</div><a class="btn btn-outline-light" href="/Movies/Details/@show.MovieId#showtimes">Chọn suất chiếu mới</a> }</div></div>
<aside class="booking-summary panel"><span class="eyebrow">TÓM TẮT ĐƠN HÀNG</span><p class="order-code">@b.Code</p><div class="countdown" data-expires="@DateTime.SpecifyKind(b.ExpiresAtUtc, DateTimeKind.Utc).ToString("O")" data-server-now="@DateTime.SpecifyKind(Model.ServerNowUtc, DateTimeKind.Utc).ToString("O")"><span>Thời gian giữ ghế còn lại</span><strong id="countdown">--:--</strong></div>
<dl class="summary-list">@foreach (var d in b.Details) { <div><dt>Ghế @d.ShowtimeSeat.Seat.Label @(d.ShowtimeSeat.Seat.Type == SeatType.VIP ? "· VIP" : "")</dt><dd>@VietnamTime.Money(d.Price)</dd></div> }</dl><div class="summary-total"><span>Tổng thanh toán</span><strong>@VietnamTime.Money(b.Total)</strong></div>
@if (pending) { <button form="payment-form" id="pay-button" class="btn btn-vega w-100" type="submit">Xác nhận thanh toán →</button><p id="payment-status" class="muted small" role="status"></p> }
<p class="muted small summary-note">Khi xác nhận, bạn đồng ý với <a href="/Home/Privacy">chính sách đặt vé</a> của VEGA CINEMAS.</p><a class="text-link" href="/Booking/Details/@b.Id">Xem chi tiết đơn →</a></aside></div></section>
