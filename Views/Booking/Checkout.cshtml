@model CheckoutPage
@{
    ViewData["Title"] = "Thanh toán QR";
    var b = Model.Booking;
    var show = b.Showtime;
    var pending = (b.Status is BookingStatus.SEAT_HELD or BookingStatus.PAYMENT_PENDING) && b.ExpiresAtUtc >
Model.ServerNowUtc;
    var payment = b.Payments.SingleOrDefault(x => x.Status == PaymentStatus.PENDING);
}
<section class="container page-section">
    <div class="booking-steps"><span class="done">01 · Chọn phim & suất</span><span class="done">02 · Chọn
        ghế</span><span class="current">03 · Thanh toán</span><span>04 · Nhận vé</span></div>
        <div class="page-heading"><span class="eyebrow">CHỈ CÒN MỘT BƯỚC NỮA</span>
            <h1>Hoàn tất cuộc hẹn<span class="red">.</span></h1>
        </div>
        <div class="booking-grid">
            <div>
                <div class="panel checkout-detail">
                    <div class="summary-movie"><img src="@show.Movie.PosterUrl" alt="@show.Movie.Title" />
                        <div><span class="eyebrow">THÔNG TIN ĐẶT VÉ</span>
                            <h2>@show.Movie.Title</h2>
                            <p>@show.ScreeningRoom.Cinema.Name · @show.ScreeningRoom.Name</p>
                            <p>@VietnamTime.Local(show.StartsAtUtc).ToString("dd/MM/yyyy · HH:mm")</p>
                            <p>Ghế: <strong>@string.Join(", ", b.Details.Select(x => x.ShowtimeSeat.Seat.Label))</strong>
                            </p>
                        </div>
                    </div>
                    <partial name="_BookingCustomer"
                             model="@(new CustomerContact(b.User.FullName, b.User.Email ?? "", b.User.PhoneNumber))" />
                </div>
                <div class="panel checkout-method">
                    <span class="eyebrow">QUÉT MÃ · XÁC NHẬN · NHẬN VÉ</span>
                    <h2>Thanh toán bằng QR</h2>
                    <p class="muted">Đây là thanh toán, không chuyển tiền thật. Mỗi đơn có một mã QR riêng.</p>
                    @if (pending && payment is not null)
                    {
                        <div class="payment-qr-layout">
                            <div class="payment-qr-frame"><img id="payment-qr"
                                                                   src="@Url.Action("PaymentQr", new { id = b.Id, paymentId = payment.Id })"
                                                                   alt="Mã QR thanh toán đơn @b.Code" width="240" height="240" /></div>
                                <div class="payment-instructions">
                                    <h3>@VietnamTime.Money(b.Total)</h3>
                                    <ol>
                                        <li>Quét mã để mở trang xác nhận.</li>
                                        <li>Chọn xác nhận thanh toán thành công.</li>
                                        <li>Nhận vé điện tử và mã QR vào rạp.</li>
                                    </ol>
                                    <p class="muted small">Đang dùng localhost? Bấm nút bên dưới để mở cùng trang thanh toán ngay
                                        trên máy này.</p>
                                        <a id="demo-payment-link" class="btn btn-outline-light" asp-action="DemoPayment"
                                           asp-route-id="@b.Id" asp-route-paymentId="@payment.Id">Mở thanh toán QR →</a>
                                        <p class="payment-reference">Mã giao dịch <span>@payment.TransactionCode</span></p>
                                    </div>
                                </div>
                            }
                else if (pending)
                            {
                                <form asp-action="CreatePaymentQr" method="post"><input type="hidden" name="id" value="@b.Id" /><button
                                    class="btn btn-vega" type="submit">Tạo mã QR thanh toán →</button></form>
                                }
                else
                                {
                                    <div class="alert alert-warning">Đơn @T(b.Status). Không thể tiếp tục thanh toán.</div>
                                    <a class="btn btn-outline-light" href="/Movies/Details/@show.MovieId#showtimes">Chọn suất chiếu mới</a>
                                }
                            </div>
                        </div>
                        <aside class="booking-summary panel">
                            <span class="eyebrow">TÓM TẮT ĐƠN HÀNG</span>
                            <p class="order-code">@b.Code</p>
                            <div class="countdown" data-expires="@DateTime.SpecifyKind(b.ExpiresAtUtc, DateTimeKind.Utc).ToString("O")"
                                 data-server-now="@DateTime.SpecifyKind(Model.ServerNowUtc, DateTimeKind.Utc).ToString("O")"><span>Thời
                                gian giữ ghế còn lại</span><strong id="countdown">--:--</strong></div>
                                <dl class="summary-list">@foreach (var d in b.Details) {
                                    <div>
                                        <dt>Ghế @d.ShowtimeSeat.Seat.Label @(d.ShowtimeSeat.Seat.Type == SeatType.VIP ? "· VIP" : "")</dt>
                                        <dd>@VietnamTime.Money(d.Price)</dd>
                                    </div>
                                }
                            </dl>
                            <div class="summary-total"><span>Tổng thanh toán</span><strong>@VietnamTime.Money(b.Total)</strong></div>
                            <p id="payment-status" class="muted small" role="status">Vé sẽ xuất hiện sau khi xác nhận thanh toán
                                thành công.</p>
                                <a class="text-link" href="/Booking/Details/@b.Id">Xem chi tiết đơn →</a>
                            </aside>
                        </div>
                    </section>
