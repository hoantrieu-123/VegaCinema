@model SeatPage
@{ ViewData["Title"] = "Chọn ghế"; var show = Model.Showtime; }
<section class="container page-section" id="seat-picker" data-showtime="@show.Id" data-authenticated="@(User.Identity?.IsAuthenticated == true ? "true" : "false")">
<div class="booking-steps"><span class="done">01 · Chọn phim & suất</span><span class="current">02 · Chọn ghế</span><span>03 · Thanh toán</span><span>04 · Nhận vé</span></div>
<a class="back-link" href="/Movies/Details/@show.MovieId#showtimes">← Chọn suất chiếu khác</a>
<div class="section-heading"><div><span class="eyebrow">CHỖ NGỒI CHO CÂU CHUYỆN CỦA BẠN</span><h1>Chọn góc nhìn yêu thích<span class="red">.</span></h1><p class="muted">@show.Movie.Title · @show.ScreeningRoom.Cinema.Name · @show.ScreeningRoom.Name<br />@VietnamTime.Local(show.StartsAtUtc).ToString("dd/MM/yyyy · HH:mm") · 2D Phụ đề</p></div></div>
<div class="booking-grid"><div class="seat-panel panel"><div class="screen-shape"></div><p class="screen-label">M À N H Ì N H</p>
<div class="seat-scroll"><div class="seat-map">@foreach (var row in Model.Seats.GroupBy(x => x.Seat.Row)) { <div class="seat-row"><span class="row-label">@row.Key</span>@foreach (var seat in row) { <button type="button" class="seat @(seat.Seat.Type == SeatType.VIP ? "vip" : "")" data-seat="@seat.SeatId" data-label="@seat.Seat.Label" data-price="@seat.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-status="@(!seat.Seat.IsActive ? "SOLD" : seat.Status.ToString())" disabled="@(!seat.Seat.IsActive || seat.Status != SeatStatus.AVAILABLE)" aria-label="Ghế @seat.Seat.Label, @(seat.Seat.Type == SeatType.VIP ? "VIP" : "thường"), @VietnamTime.Money(seat.Price)" aria-pressed="false">@seat.Seat.Number</button> }<span class="row-label">@row.Key</span></div> }</div></div>
<div class="seat-legend"><span><i class="legend-seat"></i>Ghế thường</span><span><i class="legend-seat vip"></i>VIP</span><span><i class="legend-seat held"></i>Đang giữ</span><span><i class="legend-seat sold"></i>Đã bán</span><span><i class="legend-seat selected"></i>Đang chọn</span></div><p class="muted small text-center">Tối đa 8 ghế mỗi đơn. Ghế được giữ trong 10 phút sau khi bạn tiếp tục.</p></div>
<aside class="booking-summary panel"><span class="eyebrow">TẤM VÉ CỦA BẠN</span><div class="summary-movie"><img src="@show.Movie.PosterUrl" alt="@show.Movie.Title" /><div><h2>@show.Movie.Title</h2><span>@show.Movie.AgeRating · 2D Phụ đề</span></div></div><dl class="summary-list"><div><dt>Rạp chiếu</dt><dd>@show.ScreeningRoom.Cinema.Name</dd></div><div><dt>Phòng</dt><dd>@show.ScreeningRoom.Name</dd></div><div><dt>Suất chiếu</dt><dd>@VietnamTime.Local(show.StartsAtUtc).ToString("HH:mm · dd/MM/yyyy")</dd></div></dl>
<div class="selected-list" id="selected-seats" aria-live="polite">Chưa chọn ghế</div><div class="summary-total"><span>Tổng thanh toán</span><strong id="seat-total">0 ₫</strong></div><p id="seat-error" class="form-error" role="alert"></p>
@Html.AntiForgeryToken()
@if (User.Identity?.IsAuthenticated == true) { <button type="button" id="hold-seats" class="btn btn-vega w-100" disabled>Tiếp tục thanh toán →</button> }
else { <a class="btn btn-vega w-100" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Seats", new { id = show.Id })">Đăng nhập để đặt vé →</a> }
<p class="muted small summary-note">Giá đã bao gồm VAT. Trạng thái ghế được kiểm tra lại khi xác nhận.</p></aside></div></section>
@section Scripts { <script src="~/js/seats.js" asp-append-version="true"></script> }
