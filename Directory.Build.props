<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesPath>$(MSBuildThisFileDirectory).packages</RestorePackagesPath>
    <!-- Exported/extracted copies must not become source, Razor, or publish items. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/.local/**;**/.packages/**;**/.tools/**;**/.nuget/**;**/exports/**;**/artifacts/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
